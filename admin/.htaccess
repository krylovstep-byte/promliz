# admin/.htaccess
# Защита inc/ (никаких прямых обращений к конфигу/auth.php/db.php).

<FilesMatch "\.(sqlite|sqlite-journal|env|md|log)$">
    Require all denied
</FilesMatch>

# Скрыть листинг
Options -Indexes

# Никакого кэша на PHP-ответы — данные меняются.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
</IfModule>
